module user.types {

  spec {
    intent "提供用户域的核心值类型。所有类型均为纯值类型：无 IO、无时钟、无持久化副作用。其他模块通过 import user.types 使用这些类型，而非直接构造原始数据。"

    interface {
      type UserId          // 不透明用户 ID；内部表示：u64；由存储层分配，不可外部构造
      type EmailAddress    // 已验证的 email 地址；内部表示：String；构造时检查格式合法性
      type UserStatus      // 用户状态枚举：Active | Inactive | Suspended
      type UserProfile     // 聚合类型：{ id: UserId, email: EmailAddress, status: UserStatus }

      // 构造函数
      fn new_user_id(raw: u64) -> UserId
      fn new_email(raw: String) -> Result<EmailAddress, String>
        // 若格式非法（无 @、域名为空等），返回 Err；格式检查为 deterministic rule
      fn new_profile(id: UserId, email: EmailAddress, status: UserStatus) -> UserProfile
    }

    // 无 effects：所有函数均为纯计算，不读取外部状态
    // 无 imports：user.types 不依赖任何其他模块
  }

  checks {
    examples {
      example create_profile {
        // 验证完整用户档案的构造路径：
        //   1. 构造 UserId
        //   2. 构造合法 EmailAddress
        //   3. 组合为 UserProfile
        // 对应 examples/user_types_create_profile.rs
        let id      = user.types.new_user_id(42);
        let email   = user.types.new_email("alice@example.com");
        let profile = user.types.new_profile(id, email.unwrap(), UserStatus::Active);
        assert typeof(id)      == UserId;
        assert typeof(profile) == UserProfile;
      }

      example reject_invalid_email {
        // 验证非法 email 被拒绝
        let result = user.types.new_email("not-an-email");
        assert result.is_err();
      }
    }
    // 无 tests：业务行为验证推迟
    // 无 rules：变更过程约束推迟
  }

  implementation rust {
    //! `user.types` — core value types for the user domain.
    //!
    //! All types in this module are pure value types: no IO, no clock reads,
    //! no database access. Downstream modules that need user data import these
    //! types rather than constructing raw primitives directly.
    //!
    //! # Design notes
    //! - `UserId` and `EmailAddress` are opaque newtypes to prevent accidental
    //!   mixing of raw values.
    //! - `UserStatus` is a closed enum; new variants require an explicit change
    //!   to this module, making status changes auditable.
    //! - `UserProfile` is a plain aggregation of the three types above.
    //!
    //! # Effects
    //! None. All functions are pure computations.

    /// Opaque user identifier. The inner `u64` is not exposed to prevent
    /// callers from constructing arbitrary IDs without going through
    /// `new_user_id`.
    #[allow(dead_code)]
    pub struct UserId(u64);

    /// A validated email address. Construction always goes through
    /// `new_email`, which enforces basic format correctness.
    #[allow(dead_code)]
    pub struct EmailAddress(String);

    /// Closed set of user lifecycle states.
    pub enum UserStatus {
        Active,
        Inactive,
        Suspended,
    }

    /// Aggregated user profile: identity + contact + lifecycle state.
    pub struct UserProfile {
        pub id:     UserId,
        pub email:  EmailAddress,
        pub status: UserStatus,
    }

    /// Wrap a raw `u64` into a `UserId`.
    ///
    /// In production this value would come from the storage layer; clients
    /// should never manufacture IDs from literals.
    pub fn new_user_id(raw: u64) -> UserId {
        UserId(raw)
    }

    /// Validate and wrap a raw string into an `EmailAddress`.
    ///
    /// Applies a minimal deterministic check: the string must contain `@`
    /// and the domain part must be non-empty. Returns `Err` with a
    /// human-readable message on failure.
    pub fn new_email(raw: String) -> Result<EmailAddress, String> {
        let parts: Vec<&str> = raw.splitn(2, '@').collect();
        if parts.len() != 2 || parts[0].is_empty() || parts[1].is_empty() {
            return Err(format!("invalid email address: {:?}", raw));
        }
        Ok(EmailAddress(raw))
    }

    /// Combine identity, contact, and status into a `UserProfile`.
    pub fn new_profile(id: UserId, email: EmailAddress, status: UserStatus) -> UserProfile {
        UserProfile { id, email, status }
    }
  }

}
