module audit.log {

  spec {
    intent "记录关于用户档案操作的安全 audit events。audit.log 是整个场景中唯一的 audit 边界模块，集中承载 audit.write effect。上层模块通过 import audit.log 显式记录操作，不得散落式 logging。只接收不包含 secrets 和不必要 sensitive fields 的 event shapes。"

    imports [user.types]

    interface {
      type AuditEvent        // 审计事件：包含 actor、action、subject_id，不含 secrets
      type AuditActor        // 审计主体：执行操作的身份（System | User(UserId)）
      type ProfileAuditAction  // 操作枚举：ProfileViewed | ProfileUpdated | UserDeactivated

      fn new_event(actor: AuditActor, action: ProfileAuditAction, subject_id: UserId) -> AuditEvent
        // 构造一个安全的 audit event；不含 sensitive 字段
      fn record(event: AuditEvent) -> ()
        effects [audit.write]
        // 将 audit event 写入审计日志
    }

    effects [audit.write]
    // audit.write：由 record() 引入（写入审计日志）
    // user.types 无 effects，import 不带来 effect 传播
  }

  checks {
    examples {
      example record_profile_viewed {
        // 验证：ProfileViewed 事件可被正确记录
        // 对应 examples/audit_log_record_profile_viewed.rs
        let id     = user.types.new_user_id(1);
        let actor  = AuditActor::System;
        let action = ProfileAuditAction::ProfileViewed;
        let event  = audit.log.new_event(actor, action, id);
        audit.log.record(event);
      }

      example record_user_deactivated {
        // 验证：UserDeactivated 事件带正确 actor 可被记录
        // 对应 examples/audit_log_record_user_deactivated.rs
        let subject = user.types.new_user_id(42);
        let actor   = AuditActor::System;
        let event   = audit.log.new_event(actor, ProfileAuditAction::UserDeactivated, subject);
        audit.log.record(event);
      }
    }
    // 无 tests：业务行为验证推迟
    // 无 rules：变更过程约束推迟
  }

  implementation rust {
    //! `audit.log` — audit event boundary for user profile operations.
    //!
    //! This module is the single audit boundary in the `Cached User Profile
    //! Service` scenario. All `audit.write` effects are funnelled through
    //! this module so that:
    //!
    //! - LLM agents can find every audit-logging callsite by querying the
    //!   Semantic DB for modules that declare `audit.write`.
    //! - The audit surface stays narrow: callers pass safe `AuditEvent`
    //!   structs that contain no secrets or raw sensitive payloads.
    //!
    //! # Effects
    //! - `audit.write`: declared at module level; introduced by `record()`.
    //!
    //! # Boundary module note
    //! `audit.log` is the *boundary module* for `audit.write`, analogous to
    //! `time.clock` for `reads_clock` and `user.store` for `db.read`/`db.write`.
    //! Under the Restricted Rust constraint, only this module may directly call
    //! the audit-sink API. All upstream modules call `audit::log::record`.

    #[allow(unused_imports)]
    use super::super::user::types::UserId;

    /// Who performed the audited operation.
    pub enum AuditActor {
        /// An automated system action (no human actor).
        System,
        /// A specific user performed the action.
        User(UserId),
    }

    /// The type of profile operation being audited.
    pub enum ProfileAuditAction {
        ProfileViewed,
        ProfileUpdated,
        UserDeactivated,
    }

    /// A safe audit event: contains actor, action type, and subject ID.
    /// Does not carry secrets, passwords, or raw sensitive profile payloads.
    pub struct AuditEvent {
        pub actor:      AuditActor,
        pub action:     ProfileAuditAction,
        pub subject_id: UserId,
    }

    /// Construct an audit event from its components.
    pub fn new_event(actor: AuditActor, action: ProfileAuditAction, subject_id: UserId) -> AuditEvent {
        AuditEvent { actor, action, subject_id }
    }

    /// Record an audit event to the audit sink.
    ///
    /// # Effects
    /// - `audit.write`: writes to the audit log.
    pub fn record(_event: AuditEvent) {
        todo!("audit.log::record: real implementation pending")
    }
  }

}
